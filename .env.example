# Catering Management System - Environment Variables Template
# Copy this to .env for local development, or set these in Render/Vercel dashboards for production

# ===========================================
# BACKEND (Render) - Required
# ===========================================
# Database - Use Render's managed PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secret - Generate a strong random string (min 32 chars)
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_ISSUER=catering-api
JWT_AUDIENCE=catering-app

# Public portal organization (optional - for multi-tenant setups)
PUBLIC_ORGANIZATION_ID=

# Public base URL for email links - MUST be your deployed frontend URL
PUBLIC_BASE_URL=https://your-app.vercel.app

# CORS allowed origins - comma-separated list of allowed frontend URLs
# Use * for development, specific domains for production
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app

# SMTP settings for email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=ARGO Catering

# ===========================================
# FRONTEND (Vercel) - Required
# ===========================================
# Backend API base URL - points to your Render backend
VITE_API_BASE=https://your-backend.onrender.com

# ===========================================
# OPTIONAL - Only if using SMTP
# ===========================================
# SMTP_PASSWORD should be an app-specific password, not your main password
# Generate at: https://myaccount.google.com/apppasswords