# Copy this file to .env and fill in real values. Never commit real secrets.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catering_db

# JWT signing — use a strong random secret of at least 32 characters
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_ISSUER=catering-api
JWT_AUDIENCE=catering-app

# Optional: the tenant the public customer portal operates against
PUBLIC_ORGANIZATION_ID=

# SMTP for ALL service emails (inquiry, quotation, booking, verification, resend).
# Use a Gmail account + an App Password, NOT the account's real password.
#   Google Account -> Security -> 2-Step Verification -> App passwords
# If SMTP_* are left unset, emails are skipped with a log warning (never fatal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=escivalladolid@gmail.com
SMTP_PASSWORD=
# HTTPS email API (works on Render free tier, which blocks outbound SMTP).
# Sign up at Brevo (brevo.com), generate an API key, verify escivalladolid@gmail.com as the sender.
# Free tier: 300 emails per day.
BREVO_API_KEY=
