# Copy this file to .env and fill in real values. Never commit real secrets.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catering_db

# JWT signing — use a strong random secret of at least 32 characters
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_ISSUER=catering-api
JWT_AUDIENCE=catering-app

# Optional: the tenant the public customer portal operates against
PUBLIC_ORGANIZATION_ID=

# SMTP for step-up email verification on sensitive admin actions.
# SMTP_PASSWORD is a real secret — set it in the environment / secrets store,
# never commit it. An example Gmail app password setup:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=escivalladolid@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=ARGO Catering
